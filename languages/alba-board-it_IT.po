msgid "Keep your changes?"
msgstr "Vuoi conservare le modifiche?"

#: includes/unsaved-drafts.php:8
msgid "This card has unsaved text. Keep editing or discard the changes before leaving it."
msgstr "Questa scheda contiene testo non salvato. Continua a modificare o scarta le modifiche prima di uscire."

#: includes/unsaved-drafts.php:9
msgid "Keep editing"
msgstr "Continua a modificare"

#: includes/unsaved-drafts.php:9
msgid "Discard changes"
msgstr "Scarta modifiche"

#: includes/unsaved-drafts.php:9

#: includes/templates.php:136
#, php-format
msgid "Preview %s"
msgstr "Aperçu de %s"

#: includes/templates.php:143
msgid "Preview only — no board has been created."
msgstr "Aperçu uniquement — aucun tableau n’a été créé."

#: includes/templates.php:147
msgid "No starter tasks in this list."
msgstr "Aucune tâche initiale dans cette liste."

#: includes/unsaved-drafts.php:8
msgid "Keep your changes?"
msgstr "Conserver vos modifications ?"

#: includes/unsaved-drafts.php:8
msgid "This card has unsaved text. Keep editing or discard the changes before leaving it."
msgstr "Cette carte contient du texte non enregistré. Continuez la saisie ou abandonnez les modifications avant de la quitter."

#: includes/unsaved-drafts.php:9
msgid "Keep editing"
msgstr "Continuer la saisie"

#: includes/unsaved-drafts.php:9
msgid "Discard changes"
msgstr "Abandonner les modifications"

#: includes/unsaved-drafts.php:9
msgid "Please wait for the current save or upload to finish."
msgstr "Attendez la fin de l’enregistrement ou du téléversement en cours."

#: includes/i18n.php:15
msgid "Delete this list and archive all of its cards?"
msgstr "Supprimer cette liste et archiver toutes ses cartes ?"

#: includes/i18n.php:16
msgid "Error deleting list."
msgstr "Erreur lors de la suppression de la liste."

#: includes/i18n.php:17
msgid "Error loading card."
msgstr "Erreur de chargement de la carte."

#: includes/i18n.php:18
msgid "Error uploading."
msgstr "Erreur de téléversement."

#: includes/i18n.php:19

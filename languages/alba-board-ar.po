msgstr ""
"تظل أذونات WordPress الحالية سارية. يمكنك فصل التطبيق من ملفك الشخصي. قد "
"يُرسل المحتوى الذي يقرؤه التطبيق إلى مزوّد الذكاء الاصطناعي."

#: includes/mcp-oauth.php:205
msgid "Allow connection"
msgstr "السماح بالاتصال"

#: includes/mcp-oauth.php:253
msgid "Could not save the connection."
msgstr "تعذّر حفظ الاتصال."

#: includes/mcp-oauth.php:257

msgstr "طلبات الرموز كثيرة جدًا."

#: includes/mcp-oauth.php:259 includes/mcp-oauth.php:309
msgid "The app could not be authenticated."
msgstr "تعذّرت مصادقة التطبيق."

#: includes/mcp-oauth.php:260

msgstr "هل تريد الاحتفاظ بتغييراتك؟"

#: includes/unsaved-drafts.php:8
msgid "This card has unsaved text. Keep editing or discard the changes before leaving it."
msgstr "تحتوي هذه البطاقة على نص غير محفوظ. تابع التعديل أو تجاهل التغييرات قبل مغادرتها."

#: includes/unsaved-drafts.php:9
msgid "Keep editing"
msgstr "متابعة التعديل"

#: includes/unsaved-drafts.php:9
msgid "Discard changes"
msgstr "تجاهل التغييرات"

#: includes/unsaved-drafts.php:9
